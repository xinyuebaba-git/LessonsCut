LESSONSCUT_ADMIN_TOKEN=replace-with-random-local-token
LESSONSCUT_DATABASE_URL=sqlite:///./data/lessonscut.db
LESSONSCUT_DATA_DIR=./data
LESSONSCUT_INPUT_ROOT=./data/input
QWEN_BASE_URL=http://192.168.14.12:30000/v1
QWEN_MODEL=qwen38-27b-uncensored-aggressive
QWEN_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_SUPERVISOR_MODEL=MiniMax-M3
MINIMAX_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_SIZE=1920x1080
# Development uses existing 3090 service; never stop or switch it.
LESSONSCUT_MAX_CALLS_PER_JOB=48
LESSONSCUT_ENCODER=libx264
